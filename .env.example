# Copy to .env for local work and replace placeholders with local-only values.
# Never commit .env. Never put database or admin secrets in Vercel.

# Backend runtime and explicit local migration command.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@localhost:5433/frost_cartel_dev
PGSSLMODE=disable
PG_POOL_MAX=10
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAME_SITE=lax

# Optional local PostgreSQL CA configuration. Use one when local TLS is enabled.
# PGSSLROOTCERT=C:/path/to/local-postgres-root-ca.crt
# PGSSLROOTCERT_CONTENT=REPLACE_WITH_LOCAL_POSTGRES_CA_PEM

# Optional local-only first-admin bootstrap. Uncomment and replace both values
# before startup only if the local database has no administrator. Password must be 16+ chars.
# ADMIN_BOOTSTRAP_USER=LOCAL_ONLY_REPLACE_ME
# ADMIN_BOOTSTRAP_PASSWORD=LOCAL_ONLY_REPLACE_WITH_RANDOM_16_PLUS_CHAR_VALUE

# Deployment marker from render.yaml. The actual auction gate is PostgreSQL
# round2_auction_config.enabled, which is seeded false. Keep both disabled.
ROUND2_AUCTION_ENABLED=false

# Optional Round 3 development inventory switch; production ignores it.
ROUND3_ENABLE_DEV_INVENTORY=false

# Test-only. Set only to a separate isolated PostgreSQL database on localhost.
# Never use a hosted or production database for PG_TEST_DATABASE_URL.
PG_TEST_DATABASE_URL=postgresql://LOCAL_TEST_USER:LOCAL_TEST_PASSWORD@localhost:5433/frost_cartel_test

# Frontend build-time setting. Leave empty locally to use the Vite /api proxy.
# In Vercel, set this public value to the Render API custom domain; never place secrets here.
VITE_API_URL=
