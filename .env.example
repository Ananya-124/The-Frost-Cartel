# ==============================================================================
# FROST CARTEL — AUTHORITATIVE ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the production or staging server.
# NEVER commit the real .env file with production credentials to GitHub!
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Authoritative Backend Database
# Defaults to Node 26 native SQLite file with WAL journal mode
SQLITE_DB_PATH=./database/frost_cartel.db

# PostgreSQL foundation (e.g. Supabase). Keep this URL server-side in Render.
# `npm run db:migrate` applies versioned migrations. Gameplay still uses SQLite
# until the later repository/service migration phase is completed.
# Supabase: use the direct URL for migrations. For Render runtime use direct
# when IPv6 is available (or IPv4 add-on enabled), otherwise the session pooler.
# Copy the exact URI and username from Supabase Dashboard > Connect.
# DATABASE_URL=postgresql://user:password@hostname:5432/postgres
# SSL defaults to verify-full. Set PGSSLROOTCERT to Supabase's downloaded CA
# certificate file (on Render, provide it as a Secret File and use its path).
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/secrets/supabase-prod-ca.crt
# Encryption-only mode is available if certificate verification is not viable:
# PGSSLMODE=require
# PG_POOL_MAX=10

# Bootstrap Tournament Administrator Account
# WARNING: In production, change immediately or provide a high-entropy secret.
ADMIN_BOOTSTRAP_USER=admin123
ADMIN_BOOTSTRAP_PASSWORD=admin@1

# Cryptographic Session & JWT/Cookie Signing Secret
SESSION_SECRET=frost-cartel-crypt-hmac-sha256-autumn-secret-change-in-prod

# Client-Side Proxy / Target Backend URL
VITE_API_URL=http://127.0.0.1:3001

# Round 2 auction: key the organizer enters in the Admin "Auction" tab
ROUND2_ADMIN_KEY=frost-r2-admin

# Round 3: enable the explicit development-only sample inventory endpoint
ROUND3_ENABLE_DEV_INVENTORY=false
