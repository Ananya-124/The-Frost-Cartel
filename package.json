{
  "name": "frost-cartel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.5 <25" },
  "scripts": {
    "dev": "vite",
    "server": "node --experimental-strip-types server/index.ts",
    "start": "node --experimental-strip-types server/index.ts",
    "db:migrate": "node --experimental-strip-types database/postgres/migrate.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --fileParallelism=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@theatre/core": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@theatre/studio": "^0.7.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
